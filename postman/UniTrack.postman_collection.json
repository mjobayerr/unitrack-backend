        {
          "id": "08553966-fcb8-4a76-867b-b55ccd0164b5",
          "name": "Suspend User",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/users/{user_id}/suspend",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "users",
                "{user_id}",
                "suspend"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Suspend an account. Takes effect on the caller's very next request.\n\nImmediate revocation is exactly what RULE 3 buys. A suspended user's access\ntoken is still cryptographically valid and unexpired \u2014 nothing can un-issue\nit. What stops them is `get_principal` reading a fresh snapshot that says\n`suspended` and raising 401. Skip the invalidation and that check reads a\nstale snapshot instead, so a suspended account keeps its access."
          }
        },
