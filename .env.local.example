# Local dev stack credentials — copy this to .env.local before running:
#   cp .env.local.example .env.local   (Linux / macOS)
#   Copy-Item .env.local.example .env.local   (Windows PowerShell)
#
# These credentials are only used inside your local Docker containers.
# You can change them, but the default values work out of the box.

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=unitrack
POSTGRES_PASSWORD=localdev
POSTGRES_DB=unitrack

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=localdev

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=localdev
GPS_INDEX=gps_points

# --- Auth (used by the init container when seeding) ---
JWT_SECRET=local-dev-secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Identity ---
ALLOWED_STUDENT_EMAIL_DOMAINS=ulab.edu.bd

# --- Operations ---
SERVICE_TIMEZONE=Asia/Dhaka
