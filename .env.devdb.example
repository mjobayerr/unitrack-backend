# Shared dev-database environment — copy to .env.devdb and fill in the values.
# .env.devdb is git-ignored. This example file IS committed.
#
#   cp .env.devdb.example .env.devdb && nano .env.devdb

# --- App (used by the init container to connect to the dev DBs) ---
ENV=dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=unitrack
POSTGRES_DB=unitrack
REDIS_HOST=redis
REDIS_PORT=6379
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USER=elastic
GPS_INDEX=gps_points

# --- Secrets (generate with: openssl rand -base64 24) ---
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
ELASTICSEARCH_PASSWORD=CHANGE_ME

# --- Dev admin account (seeded by the init container) ---
DEV_ADMIN_EMAIL=admin@ulab.edu.bd
DEV_ADMIN_PASSWORD=CHANGE_ME

# --- Auth (only needed by the init container for seed_dev token printing) ---
JWT_SECRET=dev-jwt-secret-not-used-in-prod
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Identity ---
ALLOWED_STUDENT_EMAIL_DOMAINS=ulab.edu.bd

# --- Operations ---
SERVICE_TIMEZONE=Asia/Dhaka
