# --- App ---
ENV=dev
API_HOST=0.0.0.0
API_PORT=8000

# --- Postgres ---
POSTGRES_USER=unitrack
POSTGRES_PASSWORD=unitrack
POSTGRES_DB=unitrack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Leave empty in dev (Redis runs without auth). Set in production.
REDIS_PASSWORD=

# --- Elasticsearch (GPS geo queries / analytics) ---
ELASTICSEARCH_URL=http://elasticsearch:9200
GPS_INDEX=gps_points
# docker-compose.yml runs Elasticsearch with xpack.security.enabled=true, so
# these are required — not optional as they were when security was off. The
# client only sends credentials when BOTH are set, so leaving either blank
# yields "missing authentication credentials for REST request" on every GPS
# index and every /track/nearby query. Must match ELASTIC_PASSWORD in
# docker-compose.yml; use a real secret in production.
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=dev_elastic_password

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-prod
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Identity ---
# Comma-separated varsity email domains allowed to register as students.
ALLOWED_STUDENT_EMAIL_DOMAINS=ulab.edu.bd

# --- CORS ---
# Comma-separated browser origins allowed to call this API. Leave empty until a
# web client exists: with no value the API sends no CORS headers, and browsers
# refuse cross-origin reads by default. Include the scheme and port, e.g.
#   CORS_ORIGINS=http://localhost:3000,https://unitrack.example.edu
# `*` is ignored if you set it — see cors_origin_list in app/core/config.py.
CORS_ORIGINS=

# --- Operations ---
# Fleet's local timezone. Storage is UTC; this only decides which service DAY a
# trip belongs to, so ridership reports do not split at 06:00 local.
SERVICE_TIMEZONE=Asia/Dhaka

# --- External (filled in later phases) ---
# BKASH_...=
# MAPBOX_TOKEN=
# SMTP_...=

# --- Payments (SSLCommerz) ---
# Sandbox credentials from the SSLCommerz merchant panel. `store_passwd`
# authenticates the server-side validation call that decides whether a ticket is
# issued, so it is a real secret even in sandbox. Never commit filled-in values.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# false = sandbox.sslcommerz.com. Only true with live merchant credentials.
SSLCOMMERZ_LIVE=false
# Public origin of THIS api, used to build the gateway's return URLs. It must be
# reachable from the student's browser, so not a Docker service name.
PUBLIC_BASE_URL=http://localhost:8000
# Where the student lands after the order settles — the student app's wallet.
# Empty means the API answers with its own JSON, which is only useful for curl.
CHECKOUT_RETURN_URL=

# --- Email (student verification) ---
# Unset means "do not send": registration still succeeds and the confirmation
# link is written to the log, which is what makes a laptop with no relay a
# working dev environment. Copy the link out of `docker compose logs api`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# What recipients see in From. Separate from SMTP_USER because most relays
# reject a sender that is not a verified identity.
SMTP_FROM=UniTrack <no-reply@example.edu>
# STARTTLS on 587. Set false and use port 465 for implicit TLS. Plaintext SMTP
# is never an option — the relay password would cross the wire in the clear.
SMTP_STARTTLS=true

# Public origin of the student app. Verification links point here, so a student
# lands on a real page instead of raw JSON. Empty falls back to PUBLIC_BASE_URL.
STUDENT_APP_URL=http://localhost:3001
