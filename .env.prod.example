# Production environment sample. Copy to `.env.prod` on the VPS and fill in the
# REAL values — never commit `.env.prod`.
#
#   cp .env.prod.example .env.prod   &&   nano .env.prod
#
# Used by docker-compose.prod.yml. The placeholders marked CHANGE_ME are secrets
# the whole system's safety depends on; the box gets compromised fast if they
# ship as-is.

# --- App ---
ENV=prod
API_HOST=0.0.0.0
API_PORT=8000

# --- Postgres ---
POSTGRES_USER=unitrack
# CHANGE_ME — a long random password. e.g. `openssl rand -base64 24`
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=unitrack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# CHANGE_ME — Redis runs with requirepass in prod; must match here and in
# docker-compose.prod.yml. e.g. `openssl rand -base64 24`
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://elasticsearch:9200
GPS_INDEX=gps_points
# CHANGE_ME — xpack.security is enabled in prod. This password is set on the
# built-in 'elastic' superuser. The app authenticates with this same account.
# Generate: openssl rand -base64 24
ELASTICSEARCH_PASSWORD=CHANGE_ME_strong_elastic_password
ELASTICSEARCH_USER=elastic
# JVM heap. 512m fits a small VPS; raise if you give ES more RAM.
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Auth ---
# CHANGE_ME — forge-anyone's-token if left default.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_48_byte_url_safe_secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Identity ---
ALLOWED_STUDENT_EMAIL_DOMAINS=ulab.edu.bd

# --- Operations ---
SERVICE_TIMEZONE=Asia/Dhaka

# --- Public origin ---
# The address a browser reaches this API on. Used to build the payment
# gateway's return URLs, so it must be publicly resolvable — a Docker service
# name or localhost here means the gateway can never send anyone back, and no
# IPN is registered at all.
PUBLIC_BASE_URL=https://api.kodewithmj.xyz
# Where the student lands after an order settles — the student app's wallet.
# Empty means the API answers with its own minimal JSON instead of redirecting,
# which is only useful for curl.
CHECKOUT_RETURN_URL=

# --- CORS ---
# Browser origins allowed to call this API directly, comma-separated. Leave
# EMPTY if the web app talks to its own Next.js server (the current design) —
# those requests are same-origin and need no CORS at all. `*` is ignored.
CORS_ORIGINS=

# --- Payments (SSLCommerz) ---
# From the merchant panel. For a SANDBOX store the API password is normally
# `<store_id>@ssl` — NOT the password shown in the store-detail view. A wrong
# one fails with "Store Credential Error Or Store is De-active".
SSLCOMMERZ_STORE_ID=CHANGE_ME_store_id
SSLCOMMERZ_STORE_PASSWORD=CHANGE_ME_store_api_password
# Keep false until you hold LIVE merchant credentials. Sandbox ids do not
# authenticate against the live host, and true means real money.
SSLCOMMERZ_LIVE=false

# --- Cloudflare Tunnel ---
# Get this from: Cloudflare Zero Trust > Networks > Tunnels > Create tunnel
# Configure the tunnel's public hostname:  api.kodewithmj.xyz  ->  http://nginx:80
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_paste_token_from_cloudflare_dashboard

# --- External (later phases) ---
# BKASH_...=
# MAPBOX_TOKEN=
# SMTP_...=

# --- Email (student verification) ---
# Without these, a student can register and then never log in: the account sits
# at `pending_email` and the only confirmation link goes to the container log.
# Any SMTP relay works — Brevo, Resend, Mailgun, or the university's own.
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_username
SMTP_PASSWORD=CHANGE_ME_smtp_password
# Must be an identity the relay has verified, or it will refuse to send.
SMTP_FROM=UniTrack <no-reply@kodewithmj.xyz>
SMTP_STARTTLS=true

# Public origin of the student app — where verification links land.
STUDENT_APP_URL=https://unitrack.kodewithmj.xyz
